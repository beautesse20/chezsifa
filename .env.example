# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé "service_role" : SECRÈTE, uniquement côté serveur (Vercel > Environment Variables)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Courriels autorisés à entrer dans le back office (séparés par des virgules)
ADMIN_EMAILS=chezsifa@gmail.com

# --- Optionnel : avertissement par courriel à chaque commande / demande traiteur (resend.com) ---
RESEND_API_KEY=
NOTIFY_EMAIL=chezsifa@gmail.com
NOTIFY_FROM=Chez Sifa <commandes@votre-domaine.com>

# --- Mode démo (sans Supabase, uniquement en local) ---
# Sans variables Supabase, le site tourne avec des données en mémoire.
# Mot de passe du back office en mode démo :
ADMIN_DEMO_PASSWORD=demo
